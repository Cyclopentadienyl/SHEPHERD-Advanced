# A user unit: %h below is the home of the user whose service manager runs it.
# Install to ~/.config/systemd/user/shepherd.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now shepherd
# and `loginctl enable-linger <user>` if it should start at boot rather than at
# first login.
#
# The --host value waits on the bind decision (SPEC_4 §4, item C1) and is
# deliberately left as it was.
[Unit]
Description=SHEPHERD-Advanced API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/SHEPHERD-Advanced
Environment=PYTHONUNBUFFERED=1
# serve_backend.py applies the allocator preset saved in Runtime Settings --
# the rule Restart Backend applies -- and then execs uvicorn. A bare uvicorn
# start applies none and runs the native allocator, which fragments under HGT
# training. To pin an allocator instead, set PYTORCH_ALLOC_CONF here; an
# explicit value is kept on every start and restart.
ExecStart=%h/SHEPHERD-Advanced/.venv/bin/python %h/SHEPHERD-Advanced/scripts/launch/serve_backend.py --host 0.0.0.0 --port 8264
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
